rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Who is asking ----------
    function signedIn() {
      return request.auth != null;
    }
    // Google confirmed the address (Google sign-in, or a verified email/password account).
    function hasVerifiedEmail() {
      return signedIn() && request.auth.token.email != null && request.auth.token.email_verified == true;
    }
    function myEmail() {
      return request.auth.token.email.lower();
    }
    // Account docs are keyed "email_" + the address with every non [a-z0-9] character as "_".
    function myAccountId() {
      return 'email_' + myEmail().replace('[^a-z0-9]', '_');
    }
    function rolesDoc() {
      return get(/databases/$(database)/documents/pickem_v14_commissioners/roles).data;
    }
    // Same rule as isVerifiedCommissioner() in the app and isCommissionerEmail_() in Email.js.
    // separatedatturt.com is a typo of the pool's domain that sits on the saved commissioner
    // lists; whoever registered it could create that mailbox, so it never counts.
    function isVerifiedCommissioner() {
      return hasVerifiedEmail() && !myEmail().matches('.*@separatedatturt[.]com') && (
        myEmail() == 'michael4ts14@gmail.com' ||
        myEmail() == 'commissioner@separatedatturf.com' ||
        (exists(/databases/$(database)/documents/pickem_v14_commissioners/roles) && (
          myEmail() == rolesDoc().get('primaryCommissionerEmail', '').lower() ||
          rolesDoc().get('authorizedEmails', {}).get(myEmail(), false) == true
        ))
      );
    }

    // ---------- Pool security settings (in shared_state.commissionerConfig) ----------
    function poolConfig() {
      return get(/databases/$(database)/documents/pickem_v14/shared_state).data.get('commissionerConfig', {});
    }
    // "midseason_protected" (default): link to a roster player by matching email or with the
    // commissioner's approval. "invite_code_required": a valid invite code first, then new
    // players may also add themselves. "whitelist_strict": only pre-registered emails.
    function registrationMode() {
      return poolConfig().get('securityConfig', {}).get('registrationMode', 'midseason_protected');
    }
    function notBlocked() {
      return signedIn() && !(request.auth.uid in poolConfig().get('blockedUsers', {}));
    }
    function hasInvitePass() {
      return exists(/databases/$(database)/documents/pickem_v14_invite_passes/$(request.auth.uid));
    }
    // Profile key for a roster name (lower-cased, as the app's standardizeParticipantName gives
    // it). Same as resolveOrCreateProfileForMember in auth.js.
    function keyForMember(low) {
      return low == 'michael a' ? 'michael' : (low == 'kinyion c' ? 'kinyion' : 'u_' + low.replace('[^a-z0-9]', ''));
    }

    // ---------- Who owns a player profile ----------
    // pickem_v14_bindings/{profileKey} names the one account (uid) that plays that profile.
    // Only that account (or a commissioner) can change the profile's picks.
    function bindingPath(key) {
      return /databases/$(database)/documents/pickem_v14_bindings/$(key);
    }
    function boundToMe(key) {
      return exists(bindingPath(key)) && get(bindingPath(key)).data.uid == request.auth.uid;
    }
    // Older pick docs recorded their owner as ownerUid (or the email / account doc id); that
    // owner can turn it into a binding once.
    function isMine(ownerValue) {
      return signedIn() && ownerValue in [request.auth.uid, myAccountId(), request.auth.token.email];
    }
    function legacyOwner(key) {
      let path = /databases/$(database)/documents/pickem_v14_users/$(key);
      return exists(path) && get(path).data.get('ownerUid', '') != '' && isMine(get(path).data.get('ownerUid', ''));
    }

    match /pickem_v14_bindings/{profileKey} {
      allow read: if true;
      allow create: if isVerifiedCommissioner() || (notBlocked() && selfBinding(profileKey));
      allow update, delete: if isVerifiedCommissioner();
    }
    function selfBinding(key) {
      let b = request.resource.data;
      let low = b.get('memberLow', '');
      return b.keys().hasOnly(['uid', 'email', 'displayName', 'memberName', 'memberLow', 'boundAt', 'verifiedBy']) &&
        b.uid == request.auth.uid && b.get('email', '') == myEmail() && (
          // The commissioner registered this (Google-verified) email for this roster player.
          (b.verifiedBy == 'email_match' && hasVerifiedEmail() && low != '' && key == keyForMember(low) &&
            poolConfig().get('playerEmailsMap', {}).get(low, '').lower() == myEmail()) ||
          // The pick doc already named this account as its owner (before bindings existed).
          (b.verifiedBy == 'legacy_owner' && legacyOwner(key)) ||
          // Invite-code season: a brand-new player (no pick doc yet) adds themselves.
          (b.verifiedBy == 'self_new' && registrationMode() == 'invite_code_required' && hasInvitePass() &&
            low != '' && key == keyForMember(low) &&
            !exists(/databases/$(database)/documents/pickem_v14_users/$(key)))
        );
    }

    // ---------- Requests to link an account to a player (commissioner approves) ----------
    // One per account (doc id = uid). The player can file, change or cancel it but never
    // approve it; commissioners read all of them and approve by writing the binding.
    match /pickem_v14_link_requests/{uid} {
      allow read: if isVerifiedCommissioner() || (signedIn() && request.auth.uid == uid);
      allow create, update: if isVerifiedCommissioner() || (notBlocked() && request.auth.uid == uid &&
        request.resource.data.uid == uid && request.resource.data.status == 'pending' &&
        request.resource.data.get('authEmail', '') == myEmail() &&
        registrationMode() != 'whitelist_strict' &&
        (registrationMode() != 'invite_code_required' || hasInvitePass()) &&
        (resource == null || resource.data.status in ['pending', 'rejected']));
      allow delete: if isVerifiedCommissioner() || (signedIn() && request.auth.uid == uid);
    }

    // ---------- League invite code ----------
    // The code itself is commissioner-only. Entering the right code creates your invite pass
    // (the check happens here, so the code never has to be shown to anyone). A revoked or
    // expired link (revoked == true, or expiresAtTs in the past) creates no passes.
    match /pickem_v14_security/{docId} {
      allow read, write: if isVerifiedCommissioner();
    }
    function inviteDoc() {
      return get(/databases/$(database)/documents/pickem_v14_security/invite).data;
    }
    function inviteIsLive() {
      return exists(/databases/$(database)/documents/pickem_v14_security/invite) &&
        inviteDoc().get('code', '') != '' &&
        inviteDoc().get('revoked', false) != true &&
        (inviteDoc().get('expiresAtTs', null) == null || request.time < inviteDoc().get('expiresAtTs', null));
    }
    match /pickem_v14_invite_passes/{uid} {
      allow read: if isVerifiedCommissioner() || (signedIn() && request.auth.uid == uid);
      allow create: if notBlocked() && request.auth.uid == uid && inviteIsLive() &&
        request.resource.data.code == inviteDoc().code;
      allow update, delete: if isVerifiedCommissioner();
    }

    // ---------- Pool state ----------
    // Everyone reads it. Commissioners (and the Apps Script bot, which uses the owner's Google
    // login and so isn't subject to these rules) change anything. A signed-in player changes
    // only the profile registry / privacy settings, plus the one profile named in
    // lastProfileWriter, and only if that profile is bound to their account.
    match /pickem_v14/shared_state {
      allow read: if true;
      allow write: if isVerifiedCommissioner() || playerSharedWrite();
    }
    function playerSharedWrite() {
      let meta = ['customUsers', 'profilePrivacy', 'updatedAt', 'lastProfileWriter'];
      let changed = request.resource.data.diff(resource.data).affectedKeys().difference(meta.toSet());
      let writer = request.resource.data.get('lastProfileWriter', '');
      return notBlocked() && resource != null &&
        (changed.size() == 0 || (writer != '' && changed.hasOnly([writer]) && boundToMe(writer) &&
          noStartedPickChanged(request.resource.data.get(writer, {}).get('picks', {}),
            resource.data.get(writer, {}).get('picks', {}))));
    }

    // ---------- Kickoff locks ----------
    // A player can't change the pick for a game that has kicked off. pickem_v14/kickoff_locks
    // (written by the commissioner's app with the slate) lists game ids by kickoff time:
    // { week, windows: [{ at: Timestamp, ids: ['1', ...] }] }. It only counts for the week
    // shared_state is on, so a slate the bot posts never inherits last week's locks. Rules
    // can't loop, so the first 20 kickoff times are checked.
    match /pickem_v14/kickoff_locks {
      allow read: if true;
      allow write: if isVerifiedCommissioner();
    }
    function kickoffWindows() {
      let path = /databases/$(database)/documents/pickem_v14/kickoff_locks;
      let locks = exists(path) ? get(path).data : {};
      let week = get(/databases/$(database)/documents/pickem_v14/shared_state).data.get('currentWeek', null);
      return locks.get('week', null) != null && string(locks.get('week', null)) == string(week) ? locks.get('windows', []) : [];
    }
    function noStartedPickChanged(newPicks, oldPicks) {
      let changed = newPicks.diff(oldPicks).affectedKeys();
      let w = changed.size() == 0 ? [] : kickoffWindows();
      return !(
        (w.size() > 0 && w[0].at <= request.time && changed.hasAny(w[0].ids)) ||
        (w.size() > 1 && w[1].at <= request.time && changed.hasAny(w[1].ids)) ||
        (w.size() > 2 && w[2].at <= request.time && changed.hasAny(w[2].ids)) ||
        (w.size() > 3 && w[3].at <= request.time && changed.hasAny(w[3].ids)) ||
        (w.size() > 4 && w[4].at <= request.time && changed.hasAny(w[4].ids)) ||
        (w.size() > 5 && w[5].at <= request.time && changed.hasAny(w[5].ids)) ||
        (w.size() > 6 && w[6].at <= request.time && changed.hasAny(w[6].ids)) ||
        (w.size() > 7 && w[7].at <= request.time && changed.hasAny(w[7].ids)) ||
        (w.size() > 8 && w[8].at <= request.time && changed.hasAny(w[8].ids)) ||
        (w.size() > 9 && w[9].at <= request.time && changed.hasAny(w[9].ids)) ||
        (w.size() > 10 && w[10].at <= request.time && changed.hasAny(w[10].ids)) ||
        (w.size() > 11 && w[11].at <= request.time && changed.hasAny(w[11].ids)) ||
        (w.size() > 12 && w[12].at <= request.time && changed.hasAny(w[12].ids)) ||
        (w.size() > 13 && w[13].at <= request.time && changed.hasAny(w[13].ids)) ||
        (w.size() > 14 && w[14].at <= request.time && changed.hasAny(w[14].ids)) ||
        (w.size() > 15 && w[15].at <= request.time && changed.hasAny(w[15].ids)) ||
        (w.size() > 16 && w[16].at <= request.time && changed.hasAny(w[16].ids)) ||
        (w.size() > 17 && w[17].at <= request.time && changed.hasAny(w[17].ids)) ||
        (w.size() > 18 && w[18].at <= request.time && changed.hasAny(w[18].ids)) ||
        (w.size() > 19 && w[19].at <= request.time && changed.hasAny(w[19].ids)));
    }

    // ---------- A player's own pick document ----------
    match /pickem_v14_users/{profileKey} {
      allow read: if true;
      allow create, update: if isVerifiedCommissioner() ||
        (notBlocked() && boundToMe(profileKey) && request.resource.data.get('ownerUid', '') == request.auth.uid &&
          noStartedPickChanged(request.resource.data.get('picks', {}), resource == null ? {} : resource.data.get('picks', {})));
      allow delete: if isVerifiedCommissioner();
    }

    // ---------- Account records (email, linked player, rivals) ----------
    // Private: only the account's own signed-in owner and commissioners read or write it.
    // Password hashes are never stored.
    match /pickem_v14_accounts/{docId} {
      allow read: if isVerifiedCommissioner() || (signedIn() && docId == myAccountId());
      allow write: if isVerifiedCommissioner() ||
        (signedIn() && docId == myAccountId() &&
          request.resource.data.get('uid', request.auth.uid) == request.auth.uid &&
          noNewPasswordHash());
    }

    // An old hash may stay or be removed, but none can be added or changed.
    function noNewPasswordHash() {
      return !('passwordHash' in request.resource.data) ||
        (resource != null && request.resource.data.passwordHash == resource.data.get('passwordHash', null));
    }

    // ---------- Commissioner settings (email-service URL, roles) ----------
    match /pickem_v14_commissioners/{docId} {
      allow read: if true;
      allow write: if isVerifiedCommissioner();
    }

    // ---------- Commissioner log (who / what / when) ----------
    // One doc per action. Commissioners read it and add entries under their own email
    // (or "migrated" copies of the old log); nobody edits or deletes entries.
    match /pickem_v14_commish_log/{entryId} {
      allow read: if isVerifiedCommissioner();
      allow create: if isVerifiedCommissioner() &&
        (request.resource.data.get('commishEmail', '') == myEmail() || request.resource.data.get('migrated', false) == true);
      allow update, delete: if false;
    }

    // ---------- Email send log ----------
    // Written only by the Apps Script email service (owner login); commissioners read it.
    match /pickem_v14_email_log/{docId} {
      allow read: if isVerifiedCommissioner();
      allow write: if false;
    }

    // ---------- Live scores, matchups, bot status, form map ----------
    // Still open: the GitHub Actions jobs write here without signing in (no service-account
    // secret yet). Once GOOGLE_SERVICE_ACCOUNT_JSON is set, change write to
    // isVerifiedCommissioner(); the jobs then bypass rules like the Apps Script bot.
    match /live_games/{docId} {
      allow read: if true;
      allow write: if true;
    }
  }
}
